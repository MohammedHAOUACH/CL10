\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces \textbf  {the area law and the linear potential.} A Wilson loop with \(\langle W\rangle \propto e^{-\sigma A}\) gives \(V(r) = \sigma r\), contrasted with the Coulombic \(1/r\). The tension shown is \(\sigma = 1\) in Planck units (\(= M_P^2\)), not the QCD value \(0.18\) GeV\(^2\); the physical confinement scale is not reproduced (Section 13.2).}}{17}{figure.22}\protected@file@percent }
\newlabel{fig:7}{{22}{17}{\textbf {the area law and the linear potential.} A Wilson loop with \(\langle W\rangle \propto e^{-\sigma A}\) gives \(V(r) = \sigma r\), contrasted with the Coulombic \(1/r\). The tension shown is \(\sigma = 1\) in Planck units (\(= M_P^2\)), not the QCD value \(0.18\) GeV\(^2\); the physical confinement scale is not reproduced (Section 13.2)}{figure.22}{}}
