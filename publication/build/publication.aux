\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {the one object: the 32-level spectrum of the QCA step.} The eigenphases of \(U\) at \(g_{10} = 1/5\). The 16 matter levels (red) and the 16 antimatter levels (purple) are exactly \(\pm \)-paired; the 0-point \(\DOTSB \sum@ \slimits@ _k\omega _k = \arg \det U\) vanishes and \(\det U = 1\). The smallest level, \(\omega _{\min } = 0.0115\), corresponds to \(\omega _{\min }M_P = 1.4\times 10^{17}\) GeV --- the only sub-Planck scale in the single-step spectrum, and \emph  {not} the electroweak scale.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:1}{{5}{6}{\textbf {the one object: the 32-level spectrum of the QCA step.} The eigenphases of \(U\) at \(g_{10} = 1/5\). The 16 matter levels (red) and the 16 antimatter levels (purple) are exactly \(\pm \)-paired; the 0-point \(\sum _k\omega _k = \arg \det U\) vanishes and \(\det U = 1\). The smallest level, \(\omega _{\min } = 0.0115\), corresponds to \(\omega _{\min }M_P = 1.4\times 10^{17}\) GeV --- the only sub-Planck scale in the single-step spectrum, and \emph {not} the electroweak scale}{figure.5}{}}
